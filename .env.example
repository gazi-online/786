# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encryption & HMAC (field-level, not stored in DB)
CUSTOMER_NO_ENCRYPTION_KEY=
CUSTOMER_NO_HMAC_SECRET=

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Portal (Amd-8: per-device config — this env var used only in dev/test, never in extension bundle)
PORTAL_HISTORY_URL=

# Pairing code TTL (seconds, default 600)
PAIRING_CODE_TTL_SECONDS=

# App URL (for CORS)
NEXT_PUBLIC_APP_URL=

