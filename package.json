{
  "name": "walletsync",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "lint": "pnpm -r run lint && eslint scripts --no-warn-ignored",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:db": "pnpm --filter @walletsync/web test test/isolation.test.ts",
    "db:migrate": "node scripts/migrate-db.mjs",
    "scan:pii": "node scripts/scan-pii-secrets.mjs",
    "build": "pnpm -r run build"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "eslint-config-prettier": "^9.0.0",
    "typescript-eslint": "^8.0.0"
  }
}